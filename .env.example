# ===== API Keys =====
# DeepSeek API key (required - used by QuestionAgent, PlanAgent, ExecuteAgent)
DEEPSEEK_API_KEY=

# Etherscan API key (required - used by blockchain data query skills)
ETHERSCAN_API_KEY=

# ===== Network =====
# HTTP proxy URL (optional, defaults to http://127.0.0.1:7890)
# HTTP_PROXY=

# ===== Parallel Execution (optional) =====
# Maximum parallel tasks (default: 3)
MAX_PARALLEL_TASKS=3
# Enable parallel execution mode (default: false)
# USE_PARALLEL_EXECUTION=false
# Continue execution when a step fails (default: false)
# CONTINUE_ON_FAILURE=false
# Enable review phase in parallel mode (default: false)
# ENABLE_REVIEW_IN_PARALLEL=false

# ===== Debug (optional) =====
# Enable compression debug logging (default: false)
# COMPRESSION_DEBUG=false